# Neon PostgreSQL
# Get your connection strings from https://console.neon.tech
# Use the pooled connection string (with -pooler in the hostname)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js (NextAuth v5)
# Generate with: npx auth secret
AUTH_SECRET=
# GitHub OAuth — create at https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
