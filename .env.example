# Neon PostgreSQL
# Get your connection strings from https://console.neon.tech
# Use the pooled connection string (with -pooler in the hostname)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js (NextAuth v5)
# Generate with: npx auth secret
AUTH_SECRET=
# GitHub OAuth — create at https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Resend (email)
RESEND_API_KEY=

# Set to "true" to skip email verification on register (useful when no custom domain is linked to Resend)
SKIP_EMAIL_VERIFICATION=

# App URL (used for email verification links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
